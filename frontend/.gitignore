# 依存パッケージ (サイズが大きく、package.jsonから再現可能なため)
node_modules/

# ビルド成果物 (ソースコードから生成可能なため)
dist/
dist-ssr/
*.local

# ログファイル (デバッグ用であり、共有不要なため)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# エディタ設定 (開発者個人の好みに依存するため)
.vscode/
.idea/

# 環境変数 (機密情報が含まれる可能性があるため)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS特有のファイル (開発に不要なため)
.DS_Store
Thumbs.db
